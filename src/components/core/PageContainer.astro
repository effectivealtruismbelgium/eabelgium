---
interface Props {
  width?: "sm" | "md" | "lg";
  class?: string;
}

const { class: className, width = "md" } = Astro.props;

const widthClasses = {
  sm: "max-w-4xl",
  md: "max-w-5xl",
  lg: "max-w-6xl",
};
---

<main
  class=`${widthClasses[width]} mx-auto px-4 sm:px-6 md:px-8 py-12 md:py-16 ${className}`
>
  <slot />
</main>
