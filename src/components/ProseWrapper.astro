---
interface Props {
  class?: string;
}

const { class: additionalClasses } = Astro.props;

const classes = [
  "prose",
  "prose-stone",
  "max-w-none",
  "prose-p:mb-2",
  "prose-li:mb-1",
  // a
  "prose-a:text-primary-600",
  "prose-a:underline",
  "prose-a:underline-offset-2",
  "prose-a:decoration-primary-500/30",
  "prose-a:transition-all",
  "prose-a:duration-200",
  "prose-a:ease-in-out",
  "prose-a:hover:decoration-primary-500",
  // h2
  "prose-h2:pl-4",
  "prose-h2:border-l-4",
  "prose-h2:border-primary-500",
  additionalClasses || "",
].join(" ");
---

<div class={classes}>
  <slot />
</div>
