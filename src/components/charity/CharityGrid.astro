---
import CharityCard from "./CharityCard.astro";
import { getCauseAreasWithCharities } from "../../lib/content";

const causeAreasWithCharities = await getCauseAreasWithCharities();
---

<div class="space-y-12">
  {
    causeAreasWithCharities.map((causeArea) => {
      const charities = causeArea.charities;
      if (charities.length === 0) return null;

      return (
        <div>
          <h2 class="text-base-800 border-base-200 mb-6 border-b pb-2 text-2xl font-semibold">
            {causeArea.data.name}
          </h2>
          <div class="grid items-stretch gap-6 md:grid-cols-2 lg:grid-cols-3">
            {charities.map((charity) => (
              <CharityCard
                name={charity.data.name}
                program={charity.data.program}
                description={charity.data.description}
                logo={charity.data.logo}
                href={`/charities/${charity.id}/`}
                recommendedBy={charity.data.recommendedBy}
                taxDeductible={charity.data.isTaxDeductible}
              />
            ))}
          </div>
        </div>
      );
    })
  }
</div>
