---
import ValueCard from "./ValueCard.astro";
---

<div class="grid w-full grid-cols-2 gap-4 md:grid-cols-5">
  <ValueCard
    icon="mdi:target"
    title="Impact first"
    tagline="We aim to do the most good we can, guided by evidence and reason."
  />

  <ValueCard
    icon="mdi:magnify"
    title="Open and truth-seeking"
    tagline="We explore ideas with humility and update based on what we learn."
  />

  <ValueCard
    icon="mdi:rocket-launch"
    title="Action-oriented"
    tagline="We turn insights into concrete action, careers, and projects."
  />

  <ValueCard
    icon="mdi:account-group"
    title="Collaborative"
    tagline="We collaborate and support each other to maximise our collective impact."
  />

  <ValueCard
    icon="mdi:sprout"
    title="Welcoming and inclusive"
    tagline="We want everyone to feel they belong and can contribute."
  />
</div>
