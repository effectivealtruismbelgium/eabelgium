---
import ArticleCard from "../ArticleCard.astro";
import ButtonLink from "../core/ButtonLink.astro";
import { getSortedArticles } from "../../lib/content";

type Props = {
  currentArticleId?: string;
  maxArticles?: number;
};

const { currentArticleId, maxArticles = 3 } = Astro.props;

const latestArticles = (await getSortedArticles())
  .filter((article) => article.id !== currentArticleId)
  .slice(0, maxArticles);

const gridClasses = `grid gap-8 mb-8 grid-cols-1 ${maxArticles <= 2 ? "md:grid-cols-2" : "md:grid-cols-2 lg:grid-cols-3"}`;
---

<div class="mx-auto max-w-6xl">
  <div class={gridClasses}>
    {
      latestArticles.map((article) => (
        <ArticleCard
          title={article.data.title}
          description={article.data.description}
          image={article.data.coverImage}
          link={`/articles/${article.id}/`}
          category={article.data.category ?? "Article"}
        />
      ))
    }
  </div>

  <div class="text-center">
    <ButtonLink
      href="/articles/"
      variant="neutral"
      class="inline-flex items-center"
      icon="mdi:chevron-right"
    >
      View all articles
    </ButtonLink>
  </div>
</div>
