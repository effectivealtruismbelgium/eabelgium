---
import Section from "../Section.astro";
---

<Section id="newsletter">
  <div
    class="mx-auto grid max-w-4xl items-center gap-4 py-12 sm:grid-cols-1 md:grid-cols-2"
  >
    <div class="text-center md:text-left">
      <h2 class="mb-4 text-3xl font-bold">
        Subscribe to our <span class="text-primary-600">newsletter</span>
      </h2>
      <p class="text-base-600 mb-2">
        Stay informed with our monthly updates! Get the latest news on events,
        impactful projects, opportunities across Belgium straight to your inbox.
      </p>
      <a
        href="https://eabelgium.substack.com/"
        class="text-base-600 hover:text-primary-800 underline"
      >
        Read past editions</a
      >
    </div>

    <div
      class="border-base-200 bg-surface overflow-hidden rounded-lg border p-1 shadow-xs"
    >
      <div class="mb-2 flex justify-center">
        <iframe
          title="Newsletter subscription form"
          src="https://eabelgium.substack.com/embed"
          width="100%"
          height="160"
          loading="lazy"
          frameborder="0"
          scrolling="no"></iframe>
      </div>
    </div>
  </div>
</Section>
