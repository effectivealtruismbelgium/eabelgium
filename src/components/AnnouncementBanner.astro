---
import { Icon } from "astro-icon/components";

interface Props {
  message: string;
  link: string;
  linkText?: string;
}

const { message, link, linkText = "Learn more" } = Astro.props;
---

<div
  id="announcement-banner"
  class="bg-secondary-200 text-secondary-600 border-base-border w-full transform border-b transition-transform duration-300"
>
  <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-4">
      <div class="flex flex-1 items-center justify-center gap-2">
        <Icon name="mdi:bullhorn" class="h-5 w-5 flex-shrink-0" />
        <span class="text-center">
          <span class="font-medium">{message}</span>
          <a
            href={link}
            class="hover:decoration-secondary-400 ml-2 underline underline-offset-2 transition-colors"
          >
            {linkText} →
          </a>
        </span>
      </div>
    </div>
  </div>
</div>
