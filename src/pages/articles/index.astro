---
import ArticleCard from "../../components/ArticleCard.astro";
import PageTitle from "../../components/core/PageTitle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageContainer from "../../components/core/PageContainer.astro";
import { getSortedArticles } from "../../lib/content";

const articles = await getSortedArticles();
---

<BaseLayout
  title="Articles"
  description="Our articles about Effective Altruism"
>
  <PageContainer width="sm">
    <PageTitle center class="mb-12">
      Our <span class="text-primary-600">articles</span>
    </PageTitle>
    <section>
      <div class="grid gap-8 md:grid-cols-2">
        {
          articles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              link={`/articles/${article.id}/`}
              image={article.data.coverImage}
              category={article.data.category ?? "Other"}
            />
          ))
        }
      </div>
    </section>
  </PageContainer>
</BaseLayout>
