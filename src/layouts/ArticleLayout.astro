---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import ProseWrapper from "../components/ProseWrapper.astro";
import { SITE_TITLE } from "../consts";
import LatestArticlesSection from "../components/home/LatestArticlesSection.astro";
import NewsletterSection from "../components/home/NewsletterSection.astro";
import PageContainer from "../components/core/PageContainer.astro";
import { getOgImageUrl } from "../lib/content";

type Props = {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  coverImage?: ImageMetadata;
  coverImageAlt?: string;
  coverImageCredit?: string;
  category?: string;
};

const {
  id,
  title,
  description,
  pubDate,
  updatedDate,
  coverImage,
  coverImageAlt,
  coverImageCredit,
  category,
} = Astro.props;

const pageTitle = `${title} | ${SITE_TITLE}`;
const ogImageUrl = coverImage
  ? await getOgImageUrl(coverImage, Astro.url)
  : undefined;
---

<html lang="en">
  <BaseHead
    title={pageTitle}
    description={description}
    imageUrl={ogImageUrl}
    ogType="article"
    seoProps={{
      openGraph: {
        basic: {
          title: title,
          type: "article",
          image: ogImageUrl ?? "",
        },
        article: {
          publishedTime: pubDate?.toISOString(),
          modifiedTime: updatedDate?.toISOString(),
          section: category,
          tags: [],
        },
      },
    }}
  />

  <body class="bg-background">
    <Header />
    <PageContainer width="sm">
      <ProseWrapper class="prose-figure:max-w-xl prose-figure:mx-auto">
        <article>
          <h1>{title}</h1>
          {
            coverImage && (
              <div class="not-prose my-8">
                <Image
                  src={coverImage}
                  alt={coverImageAlt || title}
                  width={1000}
                  height={400}
                  fit="cover"
                  class="h-64 w-full rounded-lg object-cover shadow-lg md:h-80"
                />
                {coverImageCredit && (
                  <p class="text-base-500 mt-2 text-center text-xs italic">
                    {coverImageCredit}
                  </p>
                )}
              </div>
            )
          }
          <div class="not-prose">
            <div class="date text-base-600 text-sm">
              <FormattedDate date={pubDate ?? new Date()} />
              {
                updatedDate && (
                  <span>
                    • Last updated on <FormattedDate date={updatedDate} />
                  </span>
                )
              }
            </div>
          </div>
          <slot />
        </article>
      </ProseWrapper>
      <div class="mt-16 mb-16 flex items-center justify-center">
        <div class="bg-base-300 h-px w-24"></div>
        <span class="text-base-400 mx-3">✦</span>
        <div class="bg-base-300 h-px w-24"></div>
      </div>
      <div class="mb-8">
        <h2 class="mb-8 text-center text-2xl font-bold">
          Other articles you might like
        </h2>

        <LatestArticlesSection currentArticleId={id} maxArticles={2} />
      </div>
      <NewsletterSection />
    </PageContainer>
    <Footer />
  </body>
</html>
